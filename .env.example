# Supabase — copy to .env.local and fill in your project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_publishable_anon_key

# Server-only admin key (NEVER expose to the browser). Required to manage system
# users (Auth) from the "Usuarios" tab. Get it from Supabase > Project Settings >
# API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# WhatsApp Cloud API — server-only. Use the DAIEGO business phone number ID
# (not the Meta test number) and an approved template on that same WABA.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=548106841724229
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=daiego_payment_success
WHATSAPP_TEMPLATE_LANGUAGE=es
